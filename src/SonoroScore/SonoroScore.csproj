<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SonoroScore</RootNamespace>
    <AssemblyName>SonoroScore</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- SS has its own version, separate from AS (repo props stay shared). -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>..\..\assets\SS.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <!-- Landing-window logo (src/SS.jpg) - copied next to the exe and into publish. -->
  <!-- Interception user-mode library: loaded from the app directory at runtime. -->
  <ItemGroup>
    <None Include="..\..\assets\interception\x64\interception.dll" Link="interception.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\SS_Quaver.jpg" Link="SS_Quaver.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SonoroScore.Core\SonoroScore.Core.csproj" />
    <ProjectReference Include="..\SonoroScore.Scanner\SonoroScore.Scanner.csproj" />
  </ItemGroup>

  <!-- Pinned OCR model: must sit in tessdata/ next to the exe. Shipping it via the
       project stops a publish from silently losing it (which silently degrades OCR). -->
  <ItemGroup>
    <None Include="..\..\assets\tessdata\eng.traineddata" Link="tessdata\eng.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
