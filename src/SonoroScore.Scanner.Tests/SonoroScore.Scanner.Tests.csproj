<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SonoroScore.Scanner\SonoroScore.Scanner.csproj" />
    <ProjectReference Include="..\SonoroScore.Core\SonoroScore.Core.csproj" />
  </ItemGroup>

  <!-- Deterministic OCR dependencies: ONE pinned tessdata model, shared with the apps, so
       dev/test and the shipped binaries run the SAME engine model. -->
  <ItemGroup>
    <None Include="..\..\assets\tessdata\eng.traineddata" Link="tessdata\eng.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Content Include="..\SonoroScore.Scanner\sonata_signatures.json">
      <Link>sonata_signatures.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Single source with the app project: the catalog lives in src/SonoroScore/. -->
    <Content Include="..\SonoroScore\echo_catalog.json">
      <Link>fixtures\catalog\echo_catalog.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
